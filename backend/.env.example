# ============ QuarkCine - Backend 环境变量模板 ============
# 复制为 .env 并填写你的值。所有变量都有开发默认值，生产部署请务必修改。

PORT=8008

# 管理员登录凭证（生产必须修改！）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=你的强密码

# JWT 签名密钥（生成：openssl rand -hex 32）
AUTH_SECRET=

# AES-256-GCM 加密密钥（生成：openssl rand -hex 32）
ENCRYPTION_KEY=

# TMDB API Key —— 二选一：
#   1) 在这里填（环境变量方式）
#   2) 留空，部署后在网页「设置 → 数据源」页填写（推荐）
# 注册地址：https://www.themoviedb.org/settings/api （免费）
TMDB_API_KEY=

TMDB_LANGUAGE=zh-CN
IMAGE_PROXY_BASE=
CACHE_TTL=3600
