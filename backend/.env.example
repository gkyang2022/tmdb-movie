# ============ TMDB Movie - Backend 环境变量模板 ============
# 复制为 .env 并填写你的值。所有变量都有开发默认值，生产部署请务必修改。

# 服务端口
PORT=8008

# 管理员登录密码（前端设置页/数据接口保护）。生产环境必须修改！
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# JWT 签名密钥（生成方式：openssl rand -hex 32）
AUTH_SECRET=

# 设置加密密钥（AES-256-GCM，必须是 64 位 hex = 32 字节）。生产环境必须设置！
# 生成：openssl rand -hex 32
ENCRYPTION_KEY=

# TMDB API Key —— 二选一：
#   1) 在这里填（环境变量方式）
#   2) 留空，部署后在网页「设置」页填写（推荐，前端可测试/即时生效）
# 注册地址：https://www.themoviedb.org/settings/api （免费）
TMDB_API_KEY=

# TMDB 请求语言（zh-CN / zh-TW / en-US）
TMDB_LANGUAGE=zh-CN

# 图片代理前缀（默认空 = 直接使用 TMDB CDN 直链）。
# 若你的网络访问 image.tmdb.org 慢/不通，可填自建反代，如 https://img.example.com/
IMAGE_PROXY_BASE=

# 缓存 TTL（秒），TMDB 免费层有限速，建议 3600
CACHE_TTL=3600
